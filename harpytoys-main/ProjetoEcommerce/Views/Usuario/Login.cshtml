@model ProjetoEcommerce.Models.Usuario;


<link href="~/css/login.css" rel="stylesheet" />


<div class="login-container">

    <div class="login-box">
        <!-- o card -->
        <!-- logo ficará sobrepondo o card -->
      
        <img src="~/img/logo_harpytoys.png" class="login-logo" />

        <div class="login-inner">
            <!-- conteúdo interno do card -->
            <h2 class="login-title">Login</h2>

            <input type="text" placeholder="Nome Usuário / Email" class="login-input" />
            <input type="password" placeholder="Senha" class="login-input" />

            <a href="#" class="forgot-link">Esqueceu a senha?</a>

            <div class="button-area">
                <button class="btn-yellow">VOLTAR</button>
                <button class="btn-yellow">ENTRAR</button>
            </div>
        </div>
    </div>

</div>
