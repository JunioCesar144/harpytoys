@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
	<link rel="stylesheet" href="~/css/login.css" />
	
</head>
<body>

    <div class="card">

        <h2 class="titulo">Seja Bem-Vindo(a)</h2>

        <form method="post" asp-controller="Usuario" asp-action="Login">

            <label>Insira seu usuário</label>
            <div class="input-box">
                <input name="email" placeholder="Email" />
            </div>

            <label>Insira sua senha</label>
            <div class="input-box">
                <input name="senha" type="password" placeholder="Senha" />
            </div>

            <button type="submit">Entrar</button>

            <a class="link" href="#">Esqueceu sua senha?</a>

            @if (ViewBag.Erro != null)
            {
                <p class="erro">@ViewBag.Erro</p>
            }
        </form>

    </div>

</body>
</html>
