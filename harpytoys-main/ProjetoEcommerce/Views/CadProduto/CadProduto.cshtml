@model ProjetoEcommerce.Models.CadProduto

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Cadastro do Produto</title>
    <link rel="stylesheet" href="~/css/cadProduto.css" />
</head>

<body>

    <div class="container">

        <!-- LOGO -->
        <img class="logo" src="~/img/logo.png" />

        <div class="card">

            <!-- BOTÃO VOLTAR -->
            <a asp-controller="Home" asp-action="Index" class="btn-voltar">
                <span class="icon-back">⬅</span> Voltar
            </a>

            <h2 class="titulo">Cadastro do Produto</h2>

            <!-- FORM -->
            <form method="post" enctype="multipart/form-data">

                <!-- campo oculto para enviar o ID na exclusão/pesquisa -->
                <input type="hidden" name="ID_Produto" value="@Model?.ID_Produto" />

                <input type="text"
                       name="Descricao"
                       placeholder="Nome do produto"
                       value="@Model?.Descricao" />

                <input type="text"
                       name="Codigo"
                       placeholder="Código"
                       value="@Model?.ID_Produto" />

                <input type="text"
                       name="Cod_Barras"
                       placeholder="Código de barras"
                       value="@Model?.Cod_Barras" />

                <input type="text"
                       name="Valor"
                       placeholder="Preço"
                       value="@Model?.Valor" />

                <!-- UPLOAD -->
                <div class="upload">
                    <label class="btn-upload">
                        Enviar Imagem
                        <input type="file" name="imagem" hidden />
                    </label>

                    <span class="icon">🖼️➕</span>
                </div>

                <!-- EXIBE A IMAGEM QUANDO PESQUISADO -->
                @if (Model != null && !string.IsNullOrEmpty(Model.Cod_Imagem))
                {
                    <div class="preview">
                        <img src="@Model.Cod_Imagem" class="preview-img" />
                    </div>
                }

                <!-- BOTÕES -->
                <div class="botoes">

                    <!-- EXCLUIR -->
                    <button type="submit" formaction="/CadProduto/Excluir" class="btn excluir">
                        Excluir
                    </button>


                    <!-- PESQUISAR -->
                    <button
                        type="submit" formaction="/CadProduto/Pesquisar" class="btn pesquisar">Pesquisar

                    </button>

                    <!-- CADASTRAR -->
                    <button type="submit"
                            formaction="/CadProduto/Cadastro"
                            class="btn cadastrar">
                        Cadastrar
                    </button>

                </div>

                <!-- MENSAGENS -->
                @if (ViewBag.Mensagem != null)
                {
                    <p class="msg sucesso">@ViewBag.Mensagem</p>
                }

                @if (ViewBag.Erro != null)
                {
                    <p class="msg erro">@ViewBag.Erro</p>
                }

            </form>

        </div>

    </div>

</body>
</html>
